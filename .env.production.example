# ============================================================
# T-ERP Production 環境變數範本
# ============================================================
# 部署到 VPS 時：cp .env.production.example .env，再填好值。
# 千萬不要把真正的 .env 推到 git（已在 .gitignore）
# ============================================================

# ── Domain（給 Caddy）───────────────────────────────────────
# 有 domain 就填網域（自動申請 Let's Encrypt SSL）：
#   DOMAIN=erp.yourcompany.com
# 還沒有 domain 就用 IP HTTP 模式：
DOMAIN=:80

# ── PostgreSQL ──────────────────────────────────────────────
DB_USER=t_erp
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
DB_NAME=t_erp_prod

# ── Backend ─────────────────────────────────────────────────
# 用 `openssl rand -hex 32` 生一個 64 字元的隨機字串
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# CORS：跟 DOMAIN 對齊
# 有 domain：CORS_ORIGIN=https://erp.yourcompany.com
# 用 IP：CORS_ORIGIN=http://YOUR.VPS.IP
CORS_ORIGIN=http://YOUR.VPS.IP

# ── Feature flags ───────────────────────────────────────────
# 給 B 客戶（角鋼，需要重量計算）：true
# 給 A 客戶（不需要重量）：false
FEATURE_WEIGHT=true
