{
  "name": "@t-erp/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "node scripts/run-electron.js --dev",
    "start": "node scripts/run-electron.js",
    "rebuild-natives": "node scripts/rebuild-natives.js",
    "postinstall": "node scripts/rebuild-natives.js",
    "package:mac": "electron-builder --mac --arm64 -c.extraMetadata.main=dist/main.js",
    "package:win": "electron-builder --win --x64 -c.extraMetadata.main=dist/main.js",
    "package:linux": "electron-builder --linux --x64 -c.extraMetadata.main=dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','release','build-resources']) fs.rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.1.0"
  },
  "build": {
    "appId": "com.terp.desktop",
    "productName": "T-ERP",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build-resources/backend",
        "to": "backend"
      },
      {
        "from": "../admin/dist",
        "to": "admin"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
